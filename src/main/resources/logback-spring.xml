<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Appender para emitir logs en formato JSON estructurado hacia la salida estándar (stdout) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="cr.ac.una.lab1.config.StructuredJsonLayout" />
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON" />
    </root>
</configuration>
