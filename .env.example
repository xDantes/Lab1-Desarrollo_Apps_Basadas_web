# ===================================================================
# Plantilla de Variables de Entorno (.env.example)
# ===================================================================
# COPIA este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# ADVERTENCIA DE SEGURIDAD:
# NUNCA guardes secretos de producción en el repositorio de Git.
# En producción, configura estas variables directamente en el panel
# del servicio gestionado (Render, Railway, etc.).

# -------------------------------------------------------------------
# 1. Configuración de Entorno y Perfil
# -------------------------------------------------------------------
# Perfiles disponibles: 'dev' (local por defecto) o 'prod' (nube gestionada)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor (en Render/Railway se inyecta automáticamente PORT)
PORT=8080

# -------------------------------------------------------------------
# 2. Base de Datos Relacional (PostgreSQL)
# -------------------------------------------------------------------
# Desarrollo local (Docker Compose):
POSTGRES_DB=lescocr
POSTGRES_USER=lescocr
POSTGRES_PASSWORD=lescocr
POSTGRES_PORT=5432

# Producción (inyectar en panel de Render/Railway con URL de Neon/Render/Supabase):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host-nube>:5432/<db_name>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<db_user>
# SPRING_DATASOURCE_PASSWORD=<db_secure_password>

# -------------------------------------------------------------------
# 3. Base de Datos Documental (MongoDB)
# -------------------------------------------------------------------
# Desarrollo local (Docker Compose):
MONGO_ROOT_USER=lescocr
MONGO_ROOT_PASSWORD=lescocr
MONGO_DB=lescocr
MONGO_PORT=27017

# Producción (MongoDB Atlas connection string segura con usuario dedicado):
# SPRING_DATA_MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/lescocr?retryWrites=true&w=majority

# -------------------------------------------------------------------
# 4. Seguridad JWT (Stateless Authentication)
# -------------------------------------------------------------------
# OBLIGATORIA: la aplicación ya no arranca sin ella (antes tenía un valor por
# defecto committeado al repo, que quedó público en el historial de Git).
# Generar una clave propia, de al menos 32 bytes (256 bits) para HS256:
#   openssl rand -base64 32
# No hay un valor de ejemplo aquí a propósito: copiarlo tal cual sería
# exactamente el mismo error que se está corrigiendo.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# 5. CORS (Control de Acceso HTTP para la SPA)
# -------------------------------------------------------------------
# Lista separada por comas de orígenes permitidos.
# En desarrollo: http://localhost:5173,http://localhost:3000
# En producción: https://tu-spa.onrender.com,https://tu-spa.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
